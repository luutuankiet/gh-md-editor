# what: base URL of the dev IDE (vite, server mode) as reached from the test browser, with trailing slash
IDE_URL=http://<tailnet-host-or-ip>:5174/
# what: port of the node API server that vite proxies /api to
IDE_API_PORT=8790
# what: auth token appended as ?token= when the server runs with auth; empty when it runs without
IDE_TOKEN=
# what: absolute path of the folder the dev server serves
IDE_SERVE_DIR=/path/to/served/folder
# what: absolute path of a workspace whose gitignored tmp/ holds other repos, used to check language servers stay clean
NOISY_WORKSPACE_DIR=/path/to/noisy/workspace
